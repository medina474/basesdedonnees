###
SELECT
    f2.film_id,
    f2.titre,
    COUNT(*) AS score
FROM films_motscles fk1
JOIN films_motscles fk2
    ON fk1.motcle_id = fk2.motcle_id
JOIN films f2
    ON f2.film_id = fk2.film_id
WHERE fk1.film_id = 63
  AND f2.film_id <> 63
GROUP BY f2.film_id, f2.titre
ORDER BY score DESC, RANDOM()
LIMIT 10;
